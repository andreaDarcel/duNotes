<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="duNotes.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:duNotes.Views"
    Title="duNotes"
    Shell.TabBarBackgroundColor="#FFFFFF"
    Shell.TabBarForegroundColor="#1E5AE6"
    Shell.TabBarTitleColor="#6B7280"
    Shell.TabBarUnselectedColor="#6B7280">

    <TabBar>
        <Tab Title="Accueil" Icon="home.svg">
            <ShellContent ContentTemplate="{DataTemplate views:AccueilPage}" />
        </Tab>
        <Tab Title="Explorer" Icon="explore.svg">
            <ShellContent ContentTemplate="{DataTemplate views:ExplorerPage}" />
        </Tab>
        <Tab Title="Déposer" Icon="upload.svg">
            <ShellContent ContentTemplate="{DataTemplate views:DepotPage}" />
        </Tab>
        <Tab Title="Hors ligne" Icon="offline.svg">
            <ShellContent ContentTemplate="{DataTemplate views:HorsLignePage}" />
        </Tab>
    </TabBar>
</Shell>