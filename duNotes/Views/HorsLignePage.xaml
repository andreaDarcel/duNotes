<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="duNotes.Views.HorsLignePage"
             Title="Hors ligne">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Vos copies locales" FontSize="22" FontAttributes="Bold" TextColor="#111827" />
            
            <Frame BackgroundColor="#EFF4FF" BorderColor="Transparent" CornerRadius="12" Padding="15">
                <VerticalStackLayout Spacing="3">
                    <Label Text="MODE HORS-LIGNE" FontSize="10" FontAttributes="Bold" TextColor="#1E5AE6" CharacterSpacing="1" />
                    <Label Text="Vos 2 documents sont prêts à être consultés." FontSize="14" FontAttributes="Bold" TextColor="#1E5AE6" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="Stockage sur cet appareil : 1,7 Mo / 100 Mo" FontSize="13" TextColor="#6B7280" />

            <CollectionView ItemsSource="{Binding DocumentsHorsLigne}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,5" Padding="15" CornerRadius="12" BorderColor="#E5E7EB" BackgroundColor="White">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                                <Frame Grid.Column="0" BackgroundColor="#EFF4FF" BorderColor="Transparent" CornerRadius="8" WidthRequest="44" HeightRequest="50" Padding="0" VerticalOptions="Center">
                                    <Label Text="PDF" FontAttributes="Bold" FontSize="11" TextColor="#1E5AE6" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Frame>
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="{Binding Titre}" FontAttributes="Bold" FontSize="15" TextColor="#111827" />
                                    <Label Text="{Binding Matiere}" FontSize="12" TextColor="#6B7280" />
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Supprimer les copies locales" Command="{Binding SupprimerCopiesCommand}" BackgroundColor="#DC2626" TextColor="White" Margin="0,15,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>