<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="duNotes.Views.HorsLignePage"
             Title="{Binding Title}">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Mes documents téléchargés" FontSize="18" FontAttributes="Bold" />
        <CollectionView ItemsSource="{Binding DocumentsSaved}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" Padding="15">
                        <Label Text="{Binding Titre}" FontAttributes="Bold" />
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>