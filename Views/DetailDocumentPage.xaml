<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="duNotes.Views.DetailDocumentPage"
             Title="{Binding Title}">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="{Binding SelectedDocument.Titre}" FontSize="22" FontAttributes="Bold" />
        <Label Text="{Binding SelectedDocument.Matiere}" TextColor="#007ACC" FontSize="14" />
        <Label Text="{Binding SelectedDocument.Description}" FontSize="14" />
        <Button Text="Télécharger pour la consultation hors-ligne" Command="{Binding TelechargerHorsLigneCommand}" />
    </VerticalStackLayout>
</ContentPage>