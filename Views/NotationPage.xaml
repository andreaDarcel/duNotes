<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="duNotes.Views.NotationPage"
             Title="{Binding Title}">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Évaluer ce document" FontSize="20" FontAttributes="Bold" />
        <Editor Placeholder="Laissez votre avis..." Text="{Binding Commentaire}" HeightRequest="100" />
        <Button Text="Envoyer l'avis" Command="{Binding SoumettreAvisCommand}" />
    </VerticalStackLayout>
</ContentPage>