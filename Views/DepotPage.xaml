<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="duNotes.Views.DepotPage"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Label Text="Partager une ressource" FontSize="24" FontAttributes="Bold" TextColor="#182230" />
            <Label Text="Aidez votre promotion à réviser avec un document clair et bien décrit." FontSize="14" TextColor="#667085" Margin="0,0,0,8" />
            <Label Text="Fichier PDF" FontSize="12" FontAttributes="Bold" TextColor="#344054" />
            <Border Stroke="#D0D5DD" StrokeDashArray="5,4" StrokeShape="RoundRectangle 10" Padding="16" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding NomFichier}" FontSize="13" TextColor="#667085" LineBreakMode="TailTruncation" />
                    <Button Text="Choisir un fichier" Command="{Binding ChoisirFichierCommand}" BackgroundColor="#EEF4FF" TextColor="#1E5AE6" />
                </VerticalStackLayout>
            </Border>
            <Label Text="Titre du document" FontSize="12" FontAttributes="Bold" TextColor="#344054" Margin="0,6,0,0" />
            <Entry Placeholder="Ex. Fiche de révision - Suites" Text="{Binding Titre}" />
            <Label Text="Matière" FontSize="12" FontAttributes="Bold" TextColor="#344054" />
            <Entry Placeholder="Ex. Mathématiques" Text="{Binding Matiere}" />
            <Label Text="Niveau" FontSize="12" FontAttributes="Bold" TextColor="#344054" />
            <Entry Placeholder="Ex. Licence 1" Text="{Binding Niveau}" />
            <Label Text="Description" FontSize="12" FontAttributes="Bold" TextColor="#344054" />
            <Editor Placeholder="Présentez le contenu et les notions abordées." Text="{Binding Description}" HeightRequest="100" BackgroundColor="White" />
            <Label Text="{Binding MessageErreur}" IsVisible="{Binding AUneErreur}" FontSize="12" TextColor="#B42318" />
            <Button Text="Publier le document" Command="{Binding PublierCommand}" BackgroundColor="#D83A4E" Margin="0,8,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>