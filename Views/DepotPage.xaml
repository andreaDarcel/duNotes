<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="duNotes.Views.DepotPage"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Déposer un document" FontSize="20" FontAttributes="Bold" />
            <Entry Placeholder="Titre du document" Text="{Binding Titre}" />
            <Entry Placeholder="Matière (ex: Informatique)" Text="{Binding Matiere}" />
            <Entry Placeholder="Niveau (ex: Licence 3)" Text="{Binding Niveau}" />
            <Editor Placeholder="Description courte..." Text="{Binding Description}" HeightRequest="100" />
            <Button Text="Publier le document" Command="{Binding PublierCommand}" BackgroundColor="#007ACC" TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>