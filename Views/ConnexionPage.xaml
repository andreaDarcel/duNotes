<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="duNotes.Views.ConnexionPage"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <Grid Padding="28,64,28,32" RowDefinitions="Auto,Auto,Auto,*">
            <HorizontalStackLayout Grid.Row="0" Spacing="10" VerticalOptions="Start">
                <Border BackgroundColor="#1E5AE6" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="38" WidthRequest="38">
                    <Label Text="d" TextColor="White" FontSize="25" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
                <Label Text="duNotes" FontSize="22" FontAttributes="Bold" TextColor="#1E5AE6" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>

            <VerticalStackLayout Grid.Row="1" Spacing="8" Margin="0,42,0,26">
                <Label Text="Moins chercher.&#10;Mieux réviser." FontSize="32" FontAttributes="Bold" LineHeight="1.05" TextColor="#182230" />
                <Label Text="Cours et annales, réunis au même endroit pour préparer vos révisions." FontSize="15" LineHeight="1.35" TextColor="#667085" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="2" Spacing="8">
                <Label Text="Adresse e-mail" FontSize="12" FontAttributes="Bold" TextColor="#344054" />
                <Entry Placeholder="camille@exemple.fr" Text="{Binding Email}" Keyboard="Email" ReturnType="Next" />
                <Label Text="Mot de passe" FontSize="12" FontAttributes="Bold" TextColor="#344054" Margin="0,10,0,0" />
                <Entry Placeholder="Votre mot de passe" Text="{Binding MotDePasse}" IsPassword="True" ReturnType="Go" />
                <Grid ColumnDefinitions="Auto,*" Margin="0,8,0,4">
                    <CheckBox IsChecked="{Binding ResterConnecte}" Color="#1E5AE6" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Rester connecté sur cet appareil" FontSize="12" TextColor="#667085" VerticalTextAlignment="Center" />
                </Grid>
                <Label Text="{Binding MessageErreur}" IsVisible="{Binding AUneErreur}" FontSize="12" TextColor="#B42318" />
                <Button Text="Se connecter" Command="{Binding SeConnecterCommand}" BackgroundColor="#D83A4E" Margin="0,8,0,0" />
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,10,0,0">
                    <Label Text="Nouveau sur duNotes ?" FontSize="12" TextColor="#667085" />
                    <Label Text="Créer un compte" FontSize="12" FontAttributes="Bold" TextColor="#1E5AE6">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OuvrirInscriptionCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>